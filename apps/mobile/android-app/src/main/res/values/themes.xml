<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Yap" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Held on screen until auth state resolves, so the login screen never flashes past a
         logged-in user (FR-024, research.md R12). -->
    <style name="Theme.Yap.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Yap</item>
    </style>
</resources>
