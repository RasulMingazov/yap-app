# Server configuration. Copy to `.env` at the repository root and fill in the real values.
#
# `AppConfigLoader` in `services/server/core-config` is the only thing that reads this file, and a
# real environment variable of the same name always wins over the value here.

APP_ENV=development
PORT=8080

# Set to true wherever a proxy terminates TLS. With it off behind a proxy every request appears to
# come from the proxy, so the per-IP rate limit below would throttle everyone at once.
TRUST_PROXY_HEADERS=false

DATABASE_URL=jdbc:postgresql://localhost:5432/yap
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_SIZE=10

# At least 43 characters, generated securely. The process refuses to start on a short or
# well-known value rather than issuing forgeable tokens.
JWT_SECRET=
JWT_ISSUER=yap-backend
JWT_AUDIENCE=yap-mobile

ACCESS_TOKEN_TTL_SECONDS=900

# 90 days. A successful rotation is the only event that renews a session, and it pushes this window
# forward from the rotation rather than from the original login.
REFRESH_TOKEN_TTL_SECONDS=7776000

# Per originating IP, across all three unauthenticated auth endpoints.
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# OAuth client IDs from the Google Cloud console. The web client ID is the `serverClientId` both
# mobile platforms send; the Android and iOS IDs are the audiences of tokens minted through the
# browser fallback, so all three are configured here.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
